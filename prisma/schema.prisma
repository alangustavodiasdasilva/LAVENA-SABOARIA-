generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["saboaria"]
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@schema("saboaria")
}

// IN_STOCK | IN_PRODUCTION | OUT_OF_STOCK
model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String
  benefits    String?
  ingredients String?
  price       Float
  salePrice   Float?
  size        String?
  // Essência/aroma do produto base (quando há variações de essência)
  essence     String?
  imageUrl    String?
  images      String[] @default([])
  stockStatus String   @default("IN_STOCK")
  stockQuantity Int    @default(0)
  lowStockAlert Int    @default(3)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  isFeatured  Boolean  @default(false)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  variants    ProductVariant[]

  @@index([categoryId])
  @@schema("saboaria")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Essência/aroma (ou, em produtos antigos, o tamanho) desta variação
  name          String
  // Tamanho/peso desta variação (opcional)
  size          String?
  price         Float
  salePrice     Float?
  imageUrl      String?
  stockStatus   String   @default("IN_STOCK")
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
  @@schema("saboaria")
}

model Settings {
  id               String   @id @default("default")
  whatsappNumber   String?
  heroImageUrl     String?
  heroImageUrlLink String?
  heroImages       String[] @default([])
  heroImageLinks   String[] @default([])
  adminPassword    String?
  instagramUrl     String?
  announcement     String?
  deliveryInfo     String?
  // Versão sazonal do site: auto | padrao | natal | ano-novo | ...
  siteTheme        String   @default("padrao")
  // Foto da seção "Presentes" da página inicial
  giftImageUrl     String?
  // Foto e legenda (ex.: nome de quem aparece) da seção "Nossa história"
  storyImageUrl    String?
  storyCaption     String?
  // Sessões do admin emitidas antes desta data deixam de valer (troca de senha)
  sessionsValidFrom DateTime?
  updatedAt        DateTime @updatedAt

  @@schema("saboaria")
}

model Kit {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  price         Float
  salePrice     Float?
  imageUrl      String?
  images        String[] @default([])
  productIds    String[] @default([])
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  stockQuantity Int      @default(0)
  stockStatus   String   @default("IN_STOCK")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("saboaria")
}

model PricingMaterial {
  id          String   @id @default(uuid())
  name        String
  amountPaid  Float
  quantity    Float
  unit        String   @default("g")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("saboaria")
}

model PricingRecipe {
  id            String   @id @default(uuid())
  name          String
  productId     String?
  batchYield    Int      @default(1)
  profitMargin  Float    @default(100)
  itemsJson     Json     @default("[]")
  laborCost     Float    @default(0)
  packagingCost Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("saboaria")
}

model Bag {
  id         String   @id @default(uuid())
  name       String
  imageUrl   String?
  amountPaid Float    @default(0)
  quantity   Int      @default(1)
  margin     Float    @default(100)
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@schema("saboaria")
}

// NEW | CONFIRMED | DELIVERED | CANCELED
model Order {
  id             String   @id @default(uuid())
  code           String   @unique
  // CART | GIFT
  type           String   @default("CART")
  status         String   @default("NEW")
  paid           Boolean  @default(false)
  customerName   String
  customerPhone  String?
  // PICKUP | DELIVERY | TO_ARRANGE
  deliveryMethod String   @default("TO_ARRANGE")
  address        String?
  notes          String?
  recipientName  String?
  cardMessage    String?
  itemsJson      Json     @default("[]")
  subtotal       Float
  total          Float
  adminNotes     String?
  stockDeducted  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@schema("saboaria")
}
